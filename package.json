{
  "name": "wild-life",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.spec.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:ci": "ng test --watch=false",
    "bundle:report": "node scripts/report-bundle.mjs",
    "perf:benchmark": "node scripts/benchmark-engine.mjs",
    "test:e2e": "playwright test",
    "agent:check": "node scripts/check-agent-guidance.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "typescript-eslint": "^8.70.0",
    "@playwright/test": "1.65.1"
  }
}
